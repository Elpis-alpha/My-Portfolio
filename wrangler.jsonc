{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elpis-portfolio",
  "main": ".open-next/worker.js",

  // Pins Workers runtime behaviour. Bump it now and then, with a redeploy.
  "compatibility_date": "2026-11-01",

  // nodejs_compat is required by the adapter so Node built-ins resolve.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Every page is prerendered, so the build output is served from here.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // The site has no ISR, no next/image and no server state, so there are no
  // R2, D1, KV or Images bindings to create.

  // Custom domains. The domain's DNS must be on Cloudflare. Each deploy makes
  // the Worker's custom domains match this list, so any domain added only in
  // the dashboard (Settings > Domains & Routes) is removed by the next deploy.
  // List every hostname that should serve the site here.
  "routes": [
    { "pattern": "www.elpis.cc", "custom_domain": true },
    { "pattern": "elpis.cc", "custom_domain": true }
  ]
}
