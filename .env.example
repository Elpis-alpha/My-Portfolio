# https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=*****

# https://dashboard.emailjs.com/admin/templates
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=*****

# https://dashboard.emailjs.com/admin/account
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=*****

# Public site origin, used for canonical URLs, Open Graph and the sitemap.
# Optional: production builds fall back to https://www.elpis.cc.
NEXT_PUBLIC_HOST_URL=https://www.elpis.cc

# All of the above are NEXT_PUBLIC_*, so they are inlined when the site is
# built. They must be set before `npm run build` / `npm run deploy`.
